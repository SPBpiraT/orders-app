@model OrderListViewModel

@{
}

<div class="bg-success py-3">
    <div class="container-fluid ps-4">
        <h1 class="text-dark">Заказы</h1>
        <a href="@Url.Action("Create")" class="btn btn-dark">Создать заказ</a>
    </div>
</div>

<div class="overflow-y-auto pb-3">
    <div class="container-fluid text-white px-4">
        @if (Model.Orders == null || Model.Orders.Count == 0)
        {
            <h5 class="text-dark mb-2">Список заказов пуст</h5>
            <p class="text-dark mb-0 small">Вы еще не создали ни одного заказа. Воспользуйтесь кнопкой выше, чтобы оформить первую доставку.</p>
        }
        else
        {
            @foreach (var order in Model.Orders)
            {
                <div class="card bg-dark text-white mb-3 border-secondary">
                    <div class="card-header bg-black border-secondary py-2 d-flex justify-content-between">
                        <h5 class="card-title text-white">Заказ № @order.OrderNum</h5>
                        <a asp-action="Get" asp-route-orderNum="@order.OrderNum" class="btn btn-sm btn-dark">Открыть заказ</a>
                    </div>

                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4 border-end border-secondary">
                                <h6 class="text-warning mb-2 small text-uppercase font-monospace">Отправитель</h6>
                                <div class="mb-1"><strong>Город:</strong> @order.SenderCity</div>
                                <div><strong>Адрес:</strong> @order.SenderAddress</div>
                            </div>

                            <div class="col-md-4 border-end border-secondary">
                                <h6 class="text-success mb-2 small text-uppercase font-monospace">Получатель</h6>
                                <div class="mb-1"><strong>Город:</strong> @order.RecipientCity</div>
                                <div><strong>Адрес:</strong> @order.RecipientAddress</div>
                            </div>

                            <div class="col-md-4">
                                <h6 class="text-info mb-2 small text-uppercase font-monospace">Параметры груза</h6>
                                <div class="mb-1"><strong>Вес:</strong> @order.CargoWeightKg</div>
                                <div><strong>Дата забора:</strong> @order.PickDate.ToString("dd.MM.yyyy")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
