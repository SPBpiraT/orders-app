@{
}

<div class="bg-success py-3">
    <div class="container-fluid ps-4">
        <h1 class="text-dark">Новый заказ</h1>
        <div class="text-dark-50">Заполните данные для отправки груза</div>
    </div>
</div>

<div class="text-white ps-4 mt-3" style="max-width: 900px; margin-left: 0;">
    <form class="card bg-dark text-white border-secondary needs-validation" novalidate method="post">
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6 border-end border-secondary mb-4">
                    <h5 class="text-warning mb-3 text-uppercase font-monospace small">Отправитель</h5>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Город отправителя</label>
                        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                        <div class="invalid-feedback">Укажите город отправителя</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Адрес отправителя</label>
                        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                        <div class="invalid-feedback">Укажите точный адрес</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <h5 class="text-success mb-3 text-uppercase font-monospace small">Получатель</h5>
                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Город получателя</label>
                        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                        <div class="invalid-feedback">Укажите город получателя</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-white-50 small">Адрес получателя</label>
                        <input type="text" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                        <div class="invalid-feedback">Укажите точный адрес</div>
                    </div>
                </div>

                <div class="border-top border-secondary pt-3">
                    <h5 class="text-info mb-3 text-uppercase font-monospace small">Параметры груза</h5>
                    <div class="row">
                        <div class="col-sm-6">
                            <label class="form-label text-white-50 small">Вес груза (кг)</label>
                            <input type="number" step="0.01" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                            <div class="invalid-feedback">Введите вес груза</div>
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label text-white-50 small">Дата забора груза</label>
                            <input type="date" class="form-control bg-secondary bg-opacity-25 text-white border-secondary" required />
                            <div class="invalid-feedback">Выберите дату забора</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer bg-black border-secondary d-flex gap-2 justify-content-end p-3">
            <a href="@Url.Action("Index")" class="btn btn-dark">Отмена</a>
            <button type="submit" class="btn btn-success px-4">Создать заказ</button>
        </div>
    </form>

</div>

<script>

</script>
